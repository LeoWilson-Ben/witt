[Unit]
Description=Witt open edition enrollment
After=network.target drop-vault.service

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/data/drop-vault
ExecStart=/usr/bin/node /data/drop-vault/open-enrollment-server.js
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/data/drop-vault/auth
MemoryMax=128M
TasksMax=32
UMask=0077

[Install]
WantedBy=multi-user.target
